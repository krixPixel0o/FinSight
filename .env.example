# Copy this file to .env, then replace each value with your local configuration.
DB_URL=jdbc:postgresql://localhost:5432/finsight2
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Generate a private random secret (at least 32 bytes); never commit your real value.
JWT_SECRET=replace-with-a-private-random-secret-of-at-least-32-bytes
JWT_EXPIRATION_MS=3600000
SERVER_PORT=8081
LIQUIBASE_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional health-score tuning; weights must be non-negative and total 100.
HEALTH_SCORE_MINIMUM_TRANSACTIONS=5
HEALTH_SCORE_MINIMUM_ACTIVE_MONTHS=3
HEALTH_SCORE_TARGET_EMERGENCY_MONTHS=6
HEALTH_SCORE_WEIGHT_SAVINGS=20
HEALTH_SCORE_WEIGHT_EXPENSE_CONTROL=15
HEALTH_SCORE_WEIGHT_CASH_FLOW=15
HEALTH_SCORE_WEIGHT_BUDGET=10
HEALTH_SCORE_WEIGHT_EMERGENCY_FUND=15
HEALTH_SCORE_WEIGHT_DEBT_BURDEN=15
HEALTH_SCORE_WEIGHT_GOAL_PROGRESS=10

# Statistical expense anomaly thresholds.
ANOMALY_MINIMUM_BASELINE_TRANSACTIONS=5
ANOMALY_MINIMUM_AMOUNT_MULTIPLE=2
ANOMALY_MINIMUM_STANDARD_DEVIATIONS=2

# Optional; used in the later AI integration phase. Keep this backend-only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_MAX_REQUESTS_PER_HOUR=10